# SPA fallback: rewrite unknown client-side routes to index.html
# so the server responds with HTTP 200 (not 404) for deep links.

# Never rewrite the backend API or the store (separate contexts)
RewriteRule ^/sma-backend(/.*)?$ - [L]
RewriteRule ^/store(/.*)?$ - [L]

# Serve real static build assets directly
RewriteRule ^/assets(/.*)?$ - [L]
RewriteRule ^/(index\.html|favicon\.svg|icons\.svg)$ - [L]

# Everything else -> SPA index.html
RewriteRule ^ /index.html [L]